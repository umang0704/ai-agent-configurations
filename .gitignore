# =========================================================================
# LOCAL CONTEXT GRAPH & AST INDEXERS
# =========================================================================
# Local SQLite Knowledge Graph generated by codebase-memory-mcp / Tree-sitter
.codebase-memory/
*.db
*.sqlite
*.sqlite3

# =========================================================================
# AGENTIC RUNTIMES & TEMPORARY CACHES
# =========================================================================
# Temporary agent run logs, execution sessions, and working diffs
.agents/tmp/
.agents/cache/
.copilot/cache/
*.agent.log

# Spec execution run outputs (keep .md templates, ignore generated run traces)
docs/specs/tmp/
docs/specs/*.run.json

# =========================================================================
# EDITOR & OS FILES
# =========================================================================
# macOS
.DS_Store
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Desktop.ini

# JetBrains / Cursor / VS Code workspace overrides
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/mcp.json

# =========================================================================
# LOCAL SECRETS & ENVIRONMENT OVERRIDES
# =========================================================================
.env
.env.local
*.pem
*.key
.mcp
.cursor*
.copilot*
.vscode*
